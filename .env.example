# 2027 Strategy — server environment template
# Copy to .env and fill. NEVER commit .env.

# --- Core ---
NODE_ENV=development
PORT=3317
PUBLIC_ORIGIN=http://localhost:3317
# Secret used to sign admin sessions / delete tokens (>=32 chars)
APP_SECRET=change-me-32+random-chars
# 32-byte base64 key for AES-256-GCM encryption of stored answers
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Admin (SEC-07) ---
# Owner/admin bearer token for /admin and admin API (>=24 chars, random)
ADMIN_TOKEN=

# --- LLM (server-side only; never exposed to client) ---
# DeepSeek API key from this host's credential store (or any OpenAI-compatible key)
DEEPSEEK_API_KEY=
# LLM_MODE: live | fake | deterministic  (fake/CI, deterministic = no-key fallback)
LLM_MODE=deterministic
# Route labels (optional overrides)
LLM_FAST_MODEL=deepseek-chat
LLM_STRONG_MODEL=deepseek-reasoner
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
# OpenAI-compatible alt endpoint (uncomment to override)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# --- Email (provider adapter) ---
# EMAIL_PROVIDER: console | smtp
EMAIL_PROVIDER=console
# SMTP settings when EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="2027 Strategy <no-reply@example.com>"
# Booking / pressure-test destination shown in follow-up consent copy
BOOKING_URL=

# --- Retention (PRD §13.7) ---
RETENTION_PRIVATE_HOURS=24
RETENTION_SAVED_DAYS=90
RETENTION_REPORT_MONTHS=12
RETENTION_EMAIL_LOG_DAYS=90

# --- Rate limits (SEC-03) ---
RATE_SESSION_PER_HOUR=20
RATE_AI_PER_HOUR=60
RATE_RESEND_COOLDOWN_SECONDS=600
RATE_FEEDBACK_PER_HOUR=10

# --- Privacy analytics / Pulse ---
PULSE_MIN_CELL=20
